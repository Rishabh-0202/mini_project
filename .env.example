# Copy to .env to override defaults in regrag/config.py
OLLAMA_BASE_URL=http://localhost:11434
# Answer model: "groq" (hosted gpt-oss-120b, needs GROQ_API_KEY below) or "ollama" (local, offline)
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
# Local Ollama model, used only when LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Best cross-encoder logit below this => abstain without calling the LLM
ABSTAIN_SCORE=-6.0

# RAGAS judge: "ollama" (local, too weak for RAGAS's JSON prompts) or "groq"
RAGAS_JUDGE=groq
GROQ_API_KEY=
# Run `python eval/run_eval.py judge-check` to list the models your key can use
RAGAS_JUDGE_MODEL=openai/gpt-oss-120b
